# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# Local MongoDB, MongoDB Atlas URI, or leave empty/fallback to auto in-memory dev database
MONGO_URI=mongodb://127.0.0.1:27017/smart_attendance

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_key_smart_attendance_2026_production_change_this
JWT_EXPIRES_IN=7d

# Academic & Attendance Default Settings
DEFAULT_MIN_ATTENDANCE_PERCENTAGE=75
EXCELLENT_THRESHOLD=90
SAFE_THRESHOLD=80
CAUTION_THRESHOLD=75
WARNING_THRESHOLD=65
CRITICAL_THRESHOLD=65

# Email Alerts Configuration (Nodemailer)
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_FROM="Smart Attendance System" <noreply@smartattendance.edu>
